# ---------- MySQL（填你本地数仓的连接信息）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=olist_db

# ---------- 大模型（OpenAI 兼容协议，任选一家）----------
# 智谱免费：https://open.bigmodel.cn  ->  glm-4-flash（Key 形如 xxxx.yyyy）
# DeepSeek 备选：https://api.deepseek.com/v1  ->  deepseek-chat（需充值）
# 通义千问备选：https://dashscope.aliyuncs.com/compatible-mode/v1  ->  qwen-plus
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# ---------- 运行参数 ----------
PROMPT_VERSION=v7
MAX_ROWS=200
QUERY_TIMEOUT=30
